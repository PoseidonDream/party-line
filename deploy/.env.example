# Your server's web address, without https:// (a free DuckDNS name works, e.g. mygroup.duckdns.org)
DOMAIN=partyline.example.com
# Your server's public IP address (shown in your VPS provider's dashboard)
PUBLIC_IP=203.0.113.10
# The password your friends need to create an account. Leave empty to let anyone sign up.
GROUP_PASSWORD=change-me
# Account names that get admin powers. Create this account right after the first start.
ADMIN_NAMES=Poseidon
# A long random secret for the voice relay. setup.sh makes one for you.
TURN_SECRET=
# Keys for the optional media server (big voice channels). setup.sh makes them; voice-server.sh turns it on.
LIVEKIT_KEY=
LIVEKIT_SECRET=
# Party Bot sends the admins a weekly report of which features friends use: Mondays (REPORT_DAY=1; 0 is Sunday)
# from 9 in the morning (REPORT_HOUR=9), in this time zone. Set REPORT_DAY=7 to turn it off.
# TZ=Europe/Istanbul
# REPORT_DAY=1
# REPORT_HOUR=9
